# ========== SDR-OS Global .gitignore ==========

# --- Scraper Output ---
all excels/
all resumes/
leads.json
run_stats.json

# --- Environment Variables ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
env/
venv/
.venv/
.pytest_cache/

# --- Node / React / Trigger.dev ---
node_modules/
dist/
dist-ssr/
build/
.trigger/
.turbo/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
