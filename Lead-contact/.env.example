# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google AI (Gemini) Settings (Optional)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# MongoDB Settings
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=leadcontact

# For MongoDB Atlas, use:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Trigger.dev Settings (Optional)
TRIGGER_API_KEY=your_trigger_api_key_here
TRIGGER_API_URL=https://api.trigger.dev
TRIGGER_WEBHOOK_SECRET=your_webhook_secret_here

# Self-hosted worker (Trigger.dev replacement)
# If TRIGGER_API_KEY is not set, the backend will call this worker to queue jobs.
WORKER_URL=http://localhost:8787
WORKER_SECRET=change-me

# Backend URL (for Trigger.dev callbacks)
BACKEND_URL=http://localhost:8000

# Optional Settings
DEBUG=False
LOG_LEVEL=INFO

# Scraper (runs as a subprocess on the same machine as the backend)
# Set SCRAPER_DIR to the absolute path of the Scraper folder on your server.
SCRAPER_DIR=../Scraper
# Set SCRAPER_PYTHON to a python executable that has the scraper dependencies installed.
SCRAPER_PYTHON=python
