# MongoDB (used for job queue storage via Agenda)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=leadcontact

# Worker HTTP server
PORT=8787
WORKER_SECRET=change-me

# Scheduled reply checker
# Disabled by default. Enable it only if you want auto-replies running.
ENABLE_REPLY_CHECKER=false
REPLY_CHECK_EVERY=1 minute

# Google OAuth Settings (must match backend)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Backend API URL
BACKEND_URL=http://localhost:8000

# Optional: For testing
# TEST_ACCESS_TOKEN=your_test_access_token_here
# TEST_REFRESH_TOKEN=your_test_refresh_token_here
